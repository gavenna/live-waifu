tools/
vendor/

# Audio (user-managed, large binary files)
*.mp3
*.wav
*.ogg
!frontend/assets/audio/.gitkeep

# Secrets (API keys)
server/secrets.json

# Build output
dist/
war-danmaku.exe
*.jsc

